  "grammar": {
    "description": "Basic Classic Ch'olan grammar patterns",
    "word_order": "VOS (Verb-Object-Subject)",
    "ergative_absolutive": true,
    "spelling_rules": [
      {
        "rule": "CVC words",
        "pattern": "CV-CV (second vowel is silent/synharmonic)",
        "example": "ba-la-ma = BAHLAM (jaguar): ba + la + ma, final 'a' is dropped",
        "notes": "The final vowel typically matches the vowel of the preceding syllable (synharmony)"
      },
      {
        "rule": "CV words",
        "pattern": "Single syllable sign",
        "example": "ta = ta"
      },
      {
        "rule": "CVCVC words",
        "pattern": "CV-CV-CV (vowels may be synharmonic or disharmonic)",
        "example": "pa-ka-la = PAKAL (shield)"
      }
    ],
    "common_verbal_expressions": [
      { "maya": "u-tz'i-ba", "transliteration": "u tz'ihb", "meaning": "his/her writing/painting" },
      { "maya": "u-ba-hi", "transliteration": "u baah", "meaning": "his/her image/self" },
      { "maya": "ch'a-ka-ja", "transliteration": "ch'ahkaj", "meaning": "was chopped/axed (war event)" },
      { "maya": "hu-li", "transliteration": "huli", "meaning": "he/she arrived" },
      { "maya": "OCH-HA'", "transliteration": "ochha'", "meaning": "entered the water (death expression)" },
      { "maya": "CHUM-wa-ni", "transliteration": "chumwaan", "meaning": "was seated (accession)" },
      { "maya": "u-KAB-ji-ya", "transliteration": "ukabjiiy", "meaning": "under the authority of" }
    ]
  },

